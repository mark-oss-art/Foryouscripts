-- Logic Nge-ganti Nama
local function spoof(obj)
    if not obj:IsA("TextLabel") and not obj:IsA("TextButton") and not obj:IsA("TextBox") then return end
    local text = obj.Text
    if not text or text == "" or TargetName == "" then return end
    if text == TargetDisplay or text == TargetName or text:find(TargetDisplay) then return end
    local nt = text
    if nt == RealDisplay then nt = TargetDisplay
    elseif nt == RealName then nt = TargetName
    else
        if nt:find(RealDisplay) then nt = nt:gsub(RealDisplay, TargetDisplay) end
        if nt:find(RealName) then nt = nt:gsub(RealName, TargetName) end
    end
    if nt ~= text then obj.Text = nt end
end

local function monitor(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        spoof(obj)
        obj:GetPropertyChangedSignal("Text"):Connect(function() spoof(obj) end)
    end
end

